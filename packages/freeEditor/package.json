{
  "name": "@catmasks/free-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "A lightweight open-source rich text editor based on TipTap",
  "author": "catmasks",
  "keywords": [
    "editor",
    "tiptap",
    "rich-text",
    "catmasks",
    "vue-editor"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "copy-readme": "node scripts/copy-readme.mjs",
    "check-package": "node scripts/check-package.mjs",
    "type-check": "tsc --noEmit",
    "build": "pnpm run copy-readme && vite build && pnpm run check-package",
    "prepack": "pnpm run copy-readme",
    "pack": "pnpm run build && pnpm pack --out free-editor.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catmasks/freeEditor.git"
  },
  "homepage": "https://github.com/catmasks/freeEditor#readme",
  "license": "Apache",
  "bugs": {
    "url": "https://github.com/catmasks/freeEditor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@tiptap/core": "3.26.1",
    "@tiptap/extension-gapcursor": "3.26.1",
    "@tiptap/pm": "3.26.1",
    "docx": "9.7.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "mammoth": "1.12.0",
    "markdown-it": "14.3.0",
    "prosemirror-markdown": "1.13.5"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.2",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vite-plugin-bundle-dts": "0.5.0"
  }
}
