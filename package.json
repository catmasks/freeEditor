{
  "name": "free-editor",
  "private": true,
  "type": "module",
  "engines": {
    "pnpm": ">=10.26.2"
  },
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @catmasks/free-editor build",
    "lint:packages": "eslint packages/*/src/**/*.ts",
    "lint:fix:packages": "eslint packages/*/src/**/*.ts --fix",
    "lint:config:packages": "eslint packages/*/vite.config.ts",
    "lint:playground": "eslint playground/src/**/*.ts",
    "lint:fix:playground": "eslint playground/src/**/*.ts --fix",
    "lint:config:playground": "eslint playground/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
